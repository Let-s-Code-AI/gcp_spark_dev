#!/usr/bin/env bash
# Validates the commit message against Conventional Commits (see CLAUDE.md).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

subject="$(grep -v '^#' "$1" | sed -n '/[^[:space:]]/{p;q;}' || true)"

# Messages generated by git itself are let through.
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|docs|refactor|style|test|ci|build|chore|perf|revert'
pattern="^(${types})(\([a-z0-9._/-]+\))?!?: [^[:space:]].*$"

fail() {
  {
    echo "commit-msg: $1"
    echo "  subject:  ${subject:-<empty>}"
    echo "  expected: <type>(<optional scope>): <description>"
    echo "  types:    ${types//|/, }"
    echo "  example:  fix(terraform): refresh state before apply"
  } >&2
  exit 1
}

[[ "$subject" =~ $pattern ]] || fail "subject is not a Conventional Commit"
[[ "$subject" != *. ]] || fail "subject must not end with a period"
(( ${#subject} <= 72 )) || fail "subject is ${#subject} characters long (max 72)"
