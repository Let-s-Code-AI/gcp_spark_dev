  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Węzły klastra (OpenTelemetry hostmetrics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU — wykorzystanie",
      "description": "",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__PROJECT_ID__",
            "expr": "1 - avg by (instance) (rate(system_cpu_time_seconds_total{state=\"idle\"}[5m]))",
            "step": "60s"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pamięć — użyta",
      "description": "",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcm"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "__PROJECT_ID__",
            "expr": "sum by (instance) (system_memory_usage_bytes{state=\"used\"})",
            "step": "60s"
          }
        }
      ]
    },
